/**
 * Workers Static Assets 托管（无 Worker 运行时入口，产物是纯静态文件）。
 *
 * 构建：pnpm build -> dist/web
 * 部署：pnpm deploy（pnpm dlx wrangler@^4 deploy）
 *
 * html_handling=auto-trailing-slash：/privacy 与 /privacy/ 都由 privacy/index.html 提供，
 * 与 prerender 的产物布局一致。未知路径直接 404，不做 SPA 回退——所有公开路由都必须
 * 在构建期落盘，漏了就该 404 而不是悄悄回首页。
 */
{
  "name": "__APP_NAME__",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
