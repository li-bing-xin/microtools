{
  "name": "@microtools/seo-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Meta / JSON-LD / sitemap / robots builders shared by every microtool site.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
