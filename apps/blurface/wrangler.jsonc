/**
 * Workers Static Assets 托管（无 Worker 运行时入口，产物是纯静态文件）。
 *
 * 构建：pnpm build -> dist/web
 * 部署：pnpm deploy（pnpm dlx wrangler@^4 deploy）
 *
 * html_handling=auto-trailing-slash：/privacy 与 /privacy/ 都由 privacy/index.html 提供。
 *
 * not_found_handling 由 create-site 按 --mode 写入：
 * - spa（默认）：single-page-application —— 未知路径回退 index.html，由客户端路由接管；
 * - prerender：404-page —— 未知路径保持真 404（红线：预渲染站不能配 SPA 回退，否则任意 URL
 *   都返回 200，变成软 404）。scripts/verify-render-mode.mjs 会在构建时校验两者一致。
 */
{
  "name": "blurface",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
