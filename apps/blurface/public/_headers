# 缓存与安全头（Workers Static Assets 的 _headers；构建时随 public/ 复制进 out/ 根生效）
#
# 缓存策略对齐 Vercel 现状：
# - /assets/* 文件名带内容 hash → immutable 一年；
# - /models/*、/ffmpeg/* 版本由 package-lock 锁定、内容不变 → 同样 immutable；
# - HTML 不设 Cache-Control，走平台默认 etag 协商缓存（等效 Vercel 的 max-age=0 must-revalidate）。

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable

/ffmpeg/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
